---
// This was originally written by claude.
//
// A small, accessible radio-button group for vanilla forms.

export type RadioOption = { value: string; label: string; disabled: boolean };

interface Props {
  /** Form field name shared by every radio in the group. Required. */
  name: string;
  /** The question text, rendered as the fieldset's <legend>. */
  legend: string;
  /** The choices. */
  options: RadioOption[];
  /** Value that should be pre-selected. */
  defaultChoice?: string;
  /** Mark the whole group as required. */
  required: boolean;
  /** Prefix for generated element ids; defaults to `name`. Override if a
      single page renders two groups that share the same `name` for any reason. */
  idPrefix?: string;
}

const {
  name,
  legend,
  options,
  defaultChoice,
  required,
  idPrefix = name,
} = Astro.props;

---

<fieldset class="radio-group">
  <legend>{legend}</legend>
  {
    options.map((item, index) => {
      // Index-based ids stay valid even when values contain spaces or symbols.
      const id = `${idPrefix}-${index}`;
      return (
        <div class="radio-option">
          <input
            type="radio"
            id={id}
            name={name}
            value={item.value}
            checked={defaultChoice === item.value}
            disabled={item.disabled}
            required={required}
          />
          <label for={id}>{item.label}</label>
        </div>
      );
    })
  }
</fieldset>

<style>
  /* Scoped to this component by Astro. Deliberately minimal so it inherits
     your form's typography and is easy to override. */
  .radio-group {
    border: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
  }

  .radio-group legend {
    padding: 0;
    font-weight: 500;
    font-size: 0.875rem;
  }

  .radio-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-right: 1em;
  }

  .radio-option input[disabled] + label {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
